<?php
/**
 * admin/assignments.php  —  the smart assignment desk
 * Left: requests waiting for a team. Right: ranked, explained recommendations.
 */
require_once __DIR__ . '/../includes/auth.php';
require_once __DIR__ . '/../includes/priority.php';
require_role('admin');

$requestId = (int) ($_GET['request_id'] ?? 0);

$queue = db_all(
    'SELECT r.*, u.full_name AS citizen_name
       FROM waste_requests r
       LEFT JOIN users u ON u.id = r.user_id
      WHERE r.status IN ("pending","prioritized","assigned","scheduled")
        AND r.assigned_worker_id IS NULL
      ORDER BY r.priority_score DESC, r.created_at ASC
      LIMIT 40'
);

$current = db_all(
    'SELECT r.*, wu.full_name AS worker_name, w.worker_code, t.team_name, v.vehicle_number
       FROM waste_requests r
       LEFT JOIN workers w  ON w.id = r.assigned_worker_id
       LEFT JOIN users wu   ON wu.id = w.user_id
       LEFT JOIN teams t    ON t.id = r.assigned_team_id
       LEFT JOIN vehicles v ON v.id = r.vehicle_id
      WHERE r.assigned_worker_id IS NOT NULL
        AND r.status IN ("assigned","scheduled","in_progress")
      ORDER BY r.assigned_at DESC
      LIMIT 40'
);

$workers = db_all(
    'SELECT w.id, w.worker_code, w.status, w.current_load, w.max_load, w.latitude, w.longitude,
            u.full_name, t.team_name, t.waste_types AS team_waste_types, v.vehicle_number, v.vehicle_type
       FROM workers w
       JOIN users u         ON u.id = w.user_id
       LEFT JOIN teams t    ON t.id = w.team_id
       LEFT JOIN vehicles v ON v.id = w.vehicle_id
      WHERE w.status <> "removed"
      ORDER BY w.status = "available" DESC, w.current_load ASC'
);

$pageTitle    = 'Smart Assignment';
$pageSubtitle = 'Recommendation engine ranks teams by distance, load, availability and equipment';
$activeNav    = 'assign';

require __DIR__ . '/../includes/header.php';
?>

<div class="row g-3">
  <!-- ================================================== waiting requests -->
  <div class="col-xl-4">
    <div class="card card-soft">
      <div class="card-body">
        <h5 class="section-title">Waiting for a team (<?= count($queue) ?>)</h5>
        <p class="text-muted" style="font-size:.8rem">Highest priority first. Pick one to see the ranked teams.</p>

        <div id="queueList" data-focus="<?= $requestId > 0 ? $requestId : 0 ?>" style="max-height:560px;overflow:auto">
          <?php if (!$queue): ?>
            <div class="empty-state">
              <i class="bi bi-check2-circle"></i>
              <p class="mb-0 fw-600">Nothing waiting — every request has a team.</p>
            </div>
          <?php else: foreach ($queue as $r):
              $w = waste_meta($r['waste_type']); ?>
            <div class="queue-item <?= $requestId === (int) $r['id'] ? 'active' : '' ?>"
                 data-id="<?= (int) $r['id'] ?>" data-lat="<?= e($r['latitude']) ?>" data-lng="<?= e($r['longitude']) ?>"
                 data-waste="<?= e($r['waste_type']) ?>" data-score="<?= (int) $r['priority_score'] ?>"
                 data-level="<?= e($r['priority_level']) ?>"
                 style="cursor:pointer">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="min-w-0">
                  <div class="fw-600" style="font-size:.86rem">
                    #<?= (int) $r['id'] ?> · <?= e($w['label']) ?>
                  </div>
                  <div class="text-muted text-truncate" style="font-size:.76rem"><?= e($r['address']) ?></div>
                  <div class="text-muted" style="font-size:.72rem">
                    <?= e($r['citizen_name'] ?? '—') ?> · <?= e(time_ago($r['created_at'])) ?>
                  </div>
                </div>
                <?= priority_badge($r['priority_level'], (int) $r['priority_score']) ?>
              </div>
            </div>
          <?php endforeach; endif; ?>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================= recommend -->
  <div class="col-xl-8">
    <div class="card card-soft mb-3" id="pick">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div>
            <h5 class="section-title mb-1" id="recTitle">Pick a request to see recommended teams</h5>
            <div class="text-muted" style="font-size:.8rem" id="recSub">
              Score = distance 40% · availability 25% · workload 20% · equipment 15%
            </div>
          </div>
          <button class="btn btn-sm btn-light border" id="btnPickTop">
            <i class="bi bi-lightning-charge me-1"></i>Auto-assign best team
          </button>
        </div>

        <div id="recList">
          <div class="empty-state">
            <i class="bi bi-stars"></i>
            <p class="mb-1 fw-600">Recommendation engine</p>
            <p class="text-muted mb-0" style="font-size:.86rem">
              Select a request on the left — every active team is scored live against the GPS distance,
              current workload, availability and vehicle capability.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="card card-soft">
      <div class="card-body">
        <h5 class="section-title">Team board</h5>
        <div class="table-responsive">
          <table class="table align-middle sw-table mb-0">
            <thead>
              <tr><th>Team / worker</th><th>Vehicle</th><th>Status</th><th>Load</th><th>Handles</th><th>Last GPS</th></tr>
            </thead>
            <tbody>
              <?php foreach ($workers as $w):
                  $pct = $w['max_load'] ? round($w['current_load'] / $w['max_load'] * 100) : 0;
                  $cls = $w['status'] === 'available' ? 'success' : ($w['status'] === 'busy' ? 'warning' : 'secondary'); ?>
                <tr>
                  <td>
                    <div class="fw-600" style="font-size:.86rem"><?= e($w['full_name']) ?></div>
                    <div class="text-muted" style="font-size:.72rem"><?= e($w['worker_code']) ?> · <?= e($w['team_name'] ?: 'No team') ?></div>
                  </td>
                  <td style="font-size:.8rem"><?= e($w['vehicle_number'] ?: '—') ?>
                    <div class="text-muted" style="font-size:.72rem"><?= e($w['vehicle_type'] ?: '') ?></div></td>
                  <td><span class="pill bg-<?= $cls ?>-subtle text-<?= $cls ?>"><?= e(ucfirst($w['status'])) ?></span></td>
                  <td style="min-width:120px">
                    <div class="d-flex justify-content-between" style="font-size:.74rem">
                      <span><?= (int) $w['current_load'] ?>/<?= (int) $w['max_load'] ?></span>
                      <span class="text-muted"><?= $pct ?>%</span>
                    </div>
                    <div class="progress progress-thin">
                      <div class="progress-bar <?= $pct >= 90 ? 'bg-danger' : ($pct >= 60 ? 'bg-warning' : 'bg-success') ?>"
                           style="width:<?= min(100, $pct) ?>%"></div>
                    </div>
                  </td>
                  <td class="text-muted text-truncate" style="max-width:160px;font-size:.76rem">
                    <?= e(str_replace(',', ', ', $w['team_waste_types'] ?: 'general')) ?>
                  </td>
                  <td class="text-muted" style="font-size:.74rem">
                    <?= $w['latitude'] ? number_format((float) $w['latitude'], 4) . ', ' . number_format((float) $w['longitude'], 4) : 'no fix' ?>
                  </td>
                </tr>
              <?php endforeach; ?>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================= currently assigned live -->
<div class="card card-soft mt-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="section-title mb-0">Currently assigned (<?= count($current) ?>)</h5>
      <a href="<?= e(APP_URL) ?>/admin/collection-plans.php" class="btn btn-sm btn-light border">
        <i class="bi bi-signpost-split me-1"></i>Build a route plan
      </a>
    </div>

    <?php if (!$current): ?>
      <p class="text-muted mb-0" style="font-size:.86rem">No active assignments right now.</p>
    <?php else: ?>
      <div class="table-responsive">
        <table class="table align-middle sw-table mb-0">
          <thead>
            <tr><th>Request</th><th>Location</th><th>Team</th><th>Vehicle</th><th>Status</th><th>Assigned</th><th class="text-end"></th></tr>
          </thead>
          <tbody>
            <?php foreach ($current as $r):
                $w = waste_meta($r['waste_type']); ?>
              <tr>
                <td class="fw-600">#<?= (int) $r['id'] ?>
                  <div class="text-muted" style="font-size:.72rem"><?= e($w['label']) ?></div></td>
                <td class="text-truncate" style="max-width:220px"><?= e($r['address']) ?></td>
                <td><?= e($r['worker_name'] ?? '—') ?>
                  <div class="text-muted" style="font-size:.72rem"><?= e($r['worker_code'] ?? '') ?> · <?= e($r['team_name'] ?: '') ?></div></td>
                <td style="font-size:.8rem"><?= e($r['vehicle_number'] ?: '—') ?></td>
                <td><?= status_badge($r['status']) ?></td>
                <td class="text-muted" style="font-size:.78rem"><?= e(time_ago($r['assigned_at'])) ?></td>
                <td class="text-end">
                  <a href="<?= e(APP_URL) ?>/admin/request.php?id=<?= (int) $r['id'] ?>" class="btn btn-sm btn-light border">
                    <i class="bi bi-eye"></i>
                  </a>
                </td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    <?php endif; ?>
  </div>
</div>

<?php
$inlineJs = <<<'JS'
(async function () {
  let activeId = 0;
  let lastRecs = [];

  async function loadRecommendations(id) {
    activeId = id;
    const list = document.getElementById('recList');
    renderInto(list, '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-success"></div> Scoring teams…</div>');

    const res = await apiGet('workers/recommend.php', { request_id: id, limit: 6 });
    if (!res) { renderInto(list, ''); return; }
    lastRecs = res.data.recommendations;

    const rq = res.data.request;
    document.getElementById('recTitle').textContent =
      'Recommended teams for #' + rq.id + ' · ' + rq.address;
    document.getElementById('recSub').innerHTML =
      priorityBadge(rq.priority_level, rq.priority_score) +
      ' &nbsp;Score = distance 40% · availability 25% · workload 20% · equipment 15%';

    if (!lastRecs.length) {
      renderInto(list, '<div class="empty-state"><i class="bi bi-exclamation-circle"></i>' +
        '<p class="mb-0 fw-600">No active team can service this request.</p></div>');
      return;
    }

    renderInto(list, lastRecs.map(function (w, i) {
      const b = w.breakdown || {};
      const bars = [
        ['Distance', b.distance, 40],
        ['Availability', b.availability, 25],
        ['Workload', b.workload, 20],
        ['Equipment', b.compatibility, 15]
      ].map(function (x) {
        return '<div class="mb-1">' +
          '<div class="d-flex justify-content-between" style="font-size:.72rem">' +
            '<span class="text-muted">' + x[0] + '</span><span class="fw-600">' + (x[1] || 0) + '/' + x[2] + '</span></div>' +
          '<div class="progress progress-thin"><div class="progress-bar bg-success" style="width:' +
            Math.round((x[1] || 0) / x[2] * 100) + '%"></div></div></div>';
      }).join('');

      return '<div class="rec-card' + (w.is_recommended ? ' best' : '') + '">' +
        '<div class="d-flex flex-wrap align-items-start gap-2">' +
          '<span class="rec-rank">' + (i + 1) + '</span>' +
          '<div class="flex-grow-1 min-w-0">' +
            '<div class="fw-600">' + escapeHtml(w.name) +
              ' <span class="text-muted fw-normal">· ' + escapeHtml(w.code) + '</span>' +
              (w.is_recommended ? ' <span class="pill bg-success-subtle text-success ms-1">Best match</span>' : '') +
            '</div>' +
            '<div class="text-muted" style="font-size:.76rem">' +
              escapeHtml(w.team_name || 'No team') +
              (w.vehicle ? ' · ' + escapeHtml(w.vehicle) : '') +
              ' · ' + w.distance_km + ' km away' +
              ' · ETA ~' + fmtDuration(w.eta_minutes) +
              ' · load ' + w.current_load + '/' + w.max_load +
            '</div>' +
            (w.compatibility_note ? '<div class="text-muted" style="font-size:.72rem">' +
              escapeHtml(w.compatibility_note) + '</div>' : '') +
          '</div>' +
          '<div class="text-end">' +
            '<div class="fs-4 fw-bold text-success">' + w.score + '</div>' +
            '<div class="text-muted" style="font-size:.68rem">match</div>' +
          '</div>' +
          '<button class="btn btn-sm ' + (w.is_recommended ? 'btn-success' : 'btn-outline-success') +
            '" data-assign="' + w.worker_id + '">Assign</button>' +
        '</div>' +
        '<div class="row g-2 mt-1"><div class="col-md-6">' + bars + '</div></div>' +
      '</div>';
    }).join(''));

    list.querySelectorAll('[data-assign]').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        const wid = btn.dataset.assign;
        const rec = lastRecs.find(r => String(r.worker_id) === String(wid));
        btn.disabled = true;
        const res2 = await apiPost('assignments/create.php', {
          request_id: activeId,
          worker_id: wid,
          match_score: rec ? rec.score : null,
          note: rec ? ('Auto-assigned, match score ' + rec.score + '/100') : ''
        });
        if (res2) setTimeout(() => window.location.reload(), 900);
        else btn.disabled = false;
      });
    });
  }

  document.querySelectorAll('.queue-item').forEach(function (item) {
    item.addEventListener('click', function () {
      document.querySelectorAll('.queue-item').forEach(i => i.classList.remove('active'));
      item.classList.add('active');
      document.getElementById('pick').scrollIntoView({ behavior: 'smooth', block: 'start' });
      loadRecommendations(item.dataset.id);
    });
  });

  document.getElementById('btnPickTop').addEventListener('click', function () {
    if (!activeId) { showToast('Select a request first.', 'warning'); return; }
    if (!lastRecs.length) { showToast('No recommendation loaded yet.', 'warning'); return; }
    const btn = document.querySelector('[data-assign="' + lastRecs[0].worker_id + '"]');
    if (btn) btn.click();
  });

  /* Deep link: /admin/assignments.php?request_id=12 */
  const focus = parseInt(document.getElementById('queueList').dataset.focus, 10);
  if (focus) {
    const target = document.querySelector('.queue-item[data-id="' + focus + '"]');
    if (target) target.click(); else loadRecommendations(focus);
  }
})();
JS;

require __DIR__ . '/../includes/footer.php';
